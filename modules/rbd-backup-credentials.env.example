# Rclone S3 credentials for RBD backup module
# Copy to /var/lib/rbd-backup/s3.env and fill in your NAS credentials.
# This file is intentionally NOT managed by NixOS to keep secrets out of the Nix store.
#
RCLONE_CONFIG_S3NAS_TYPE=s3
RCLONE_CONFIG_S3NAS_PROVIDER=Minio
RCLONE_CONFIG_S3NAS_ENDPOINT=http://your-nas-ip:9000
RCLONE_CONFIG_S3NAS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
RCLONE_CONFIG_S3NAS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
# RCLONE_CONFIG_S3NAS_REGION=us-east-1
